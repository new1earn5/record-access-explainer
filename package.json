{
    "name": "record-access-explainer",
    "private": true,
    "version": "1.0.0",
    "description": "Record Access Explainer - Salesforce administrator/auditor application",
    "scripts": {
        "test:unit": "sfdx-lwc-jest",
        "test:unit:watch": "sfdx-lwc-jest --watch",
        "test:unit:coverage": "sfdx-lwc-jest --coverage",
        "coverage:badges": "istanbul-badges-readme",
        "lint": "eslint .",
        "format": "prettier --write \"force-app/**/*.{cls,js,html,css}\" \"*.{json,js,md}\"",
        "format:check": "prettier --check \"force-app/**/*.{cls,js,html,css}\" \"*.{json,js,md}\"",
        "analyze:apex": "sf code-analyzer run --config-file code-analyzer.yml --workspace force-app/main/default/classes --rule-selector Recommended --severity-threshold High"
    },
    "devDependencies": {
        "@lwc/eslint-plugin-lwc": "^3.5.0",
        "@salesforce/eslint-config-lwc": "^4.1.2",
        "@salesforce/eslint-plugin-lightning": "^2.0.0",
        "@salesforce/sfdx-lwc-jest": "^7.9.0",
        "eslint": "^10.12.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.16.6",
        "istanbul-badges-readme": "^1.9.0",
        "prettier": "^3.9.8",
        "prettier-plugin-apex": "^2.3.0"
    }
}
